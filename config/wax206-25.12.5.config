CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_mediatek_mt7622_DEVICE_netgear_wax206=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------------------------------------------------------------
# 根文件系统：改成 ext4，否则 172MB UBI 空间用不上
# ---------------------------------------------------------------
# 25.12.5 默认只开 squashfs（只读），ext4 默认是 not set。
# MT7622 的 image Makefile 里 FILESYSTEMS := squashfs erofs，没有 ext4，
# 所以必须让 ext4 出现在 TARGET_FILESYSTEMS 里，Device/Build 才会为
# 每个 IMAGE 生成带 ext4 根的变体（产物名形如
#   ...-squashfs-sysupgrade.bin / ...-ext4-sysupgrade.bin）。
# 只加包却不改这里，包能进固件，但 /overlay 依然只有几十 MB。
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_EXT4_JOURNAL=y
CONFIG_TARGET_EXT4_BLOCKSIZE_4K=y
CONFIG_TARGET_EXT4_RESERVED_PCT=0

# 必须 <= ubi 分区大小，否则 ext4 镜像会被 check-size 判超限。
# 默认 --size full 时 ubi = 247 MiB；用 --size 178m 就改成 172。
# 不写这行会沿用 mediatek 的默认 448，直接过不了。
CONFIG_TARGET_ROOTFS_PARTSIZE=247

# ---------------------------------------------------------------
# LuCI 应用
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-uhttpd=y

# LuCI 语言开关：语言包的 Default 写成 "LUCI_LANG_zh_Hans||(ALL&&m)"，
# 只有开了这个开关（或 ALL）它们才会被选成 =y；否则退化到 =m，
# 而目标镜像不输出 m 包 → 中文界面凭空消失。
# 原版 config 只写了 CONFIG_PACKAGE_luci-i18n-base-zh-cn=y，实测无效。
CONFIG_LUCI_LANG_zh_Hans=y

# 对应的中文语言包（不加的话界面是英文）
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ---------------------------------------------------------------
# 网络工具
# ---------------------------------------------------------------
# SQM 的 QoS 脚本本体（luci-app-sqm 只是界面，不选这个界面会报缺依赖）
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_vnstat=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_luci-app-vnstat2=n

# ---------------------------------------------------------------
# 注意（改之前先读）
# ---------------------------------------------------------------
# 1) 25.12.5 默认用 apk 而不是 opkg（CONFIG_USE_APK=y），
#    设备上装包用 apk add，不是 opkg install。
# 2) 这里的包全部来自官方 feed，`feeds install -a` 已经装好索引，
#    不需要额外加 feed。第三方包（openclash/passwall2/argon 主题）
#    不在官方源，要另加 feed，见 docs/CUSTOM_PACKAGES.md。
# 3) adguardhome 会占用 53 端口，与 dnsmasq 冲突，
#    首次启动要在 LuCI 里把 dnsmasq 的 DNS 监听改到 5353 或
#    让 AdGuardHome 走 53 并把上游指向 127.0.0.1:5353。
