# ImmortalWrt 25.12 (openwrt-25.12 分支) · Netgear WAX206 · 扩展分区
#
# 与 wax206-25.12.5.config（OpenWrt 版）的差异：
#   1. ImmortalWrt 的 default 包集不同，这里只声明我们额外要的
#   2. TARGET_ROOTFS_PARTSIZE 必须 <= ubi 分区（吃满方案下 ubi = 247 MiB），
#      否则 ext4 镜像会超出 IMAGE_SIZE 被 check-size 拦下
#   3. ext4 是否启用由 workflow 的 build_ext4 输入 + 补丁 --ext4 共同决定；
#      这里先写开，配合补丁的 FILESYSTEMS 追加才会真正产出 ext4 变体

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_mediatek_mt7622_DEVICE_netgear_wax206=y

# ---------------------------------------------------------------
# 根文件系统
# ---------------------------------------------------------------
# ImmortalWrt 的 target 默认也是 `FILESYSTEMS := squashfs erofs`，
# 所以光开这个 CONFIG 不出 ext4 镜像，必须配合补丁的 --ext4。
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_EXT4_JOURNAL=y
CONFIG_TARGET_EXT4_BLOCKSIZE_4K=y
CONFIG_TARGET_EXT4_RESERVED_PCT=0
# 必须 <= ubi 分区大小。full 方案 ubi=247MiB，这里取 247。
# 改成 --size 178m 时把这里同步改成 172。
CONFIG_TARGET_ROOTFS_PARTSIZE=247

# 25.12 默认用 apk；显式写出来，避免版本漂移时静默变回 opkg
CONFIG_USE_APK=y

# ---------------------------------------------------------------
# LuCI 与中文
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------------------------------------------------------------
# 常用 LuCI 应用（全部来自官方 feed，已核对包名存在）
# ---------------------------------------------------------------
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-uhttpd=y

CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# ---------------------------------------------------------------
# 系统工具
# ---------------------------------------------------------------
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_vnstat=y

# ---------------------------------------------------------------
# 注意
# ---------------------------------------------------------------
# 1) 要先跑 patch-immortalwrt-full256.py 再 defconfig，否则
#    IMAGE_SIZE 还是 32768k，253MiB 的固件会被 check-size 判超限。
# 2) AdGuardHome / zerotier 等按需在 packages.txt 里加即可，
#    不要在这里重复声明，避免两处不一致。
